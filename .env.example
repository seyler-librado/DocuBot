# Copia este archivo a .env y ajústalo. .env nunca se versiona.

# Contraseña de Postgres (solo se usa dentro de la red de Docker)
POSTGRES_PASSWORD=cambia-esta-contrasena

# Puertos en esta máquina (solo escuchan en 127.0.0.1)
WEB_PUERTO=8080
DB_PUERTO=5433

# Zona horaria de los contenedores
TZ=UTC

# --- IA para las fichas (ver config/docubot.yaml) ---
# DOCUBOT_IA__PROVEEDOR=ollama            # ollama | openai | openai_compat | anthropic | archivo.py:Clase
# DOCUBOT_IA__MODELO=
# DOCUBOT_IA__URL=                        # solo openai_compat o extensiones
# DOCUBOT_IA__LLAVE=                      # con Ollama local no hace falta

# --- Buscadores (fuentes de tipo "buscador") ---
# SearXNG no necesita llave: docker compose --profile searxng up -d
SEARXNG_SECRET=cambia-esta-clave-tambien
# SEARXNG_PUERTO=8888
# Brave Search API (https://brave.com/search/api/)
# DOCUBOT_BUSCADORES__BRAVE_LLAVE=
# Serper (https://serper.dev)
# DOCUBOT_BUSCADORES__SERPER_LLAVE=
# SerpAPI (https://serpapi.com)
# DOCUBOT_BUSCADORES__SERPAPI_LLAVE=
# País e idioma preferidos para los resultados
# DOCUBOT_BUSCADORES__PAIS=mx
# DOCUBOT_BUSCADORES__IDIOMA=es

# --- Búsqueda por tema (solo si usas un servidor de vectores con llave) ---
# DOCUBOT_BUSQUEDA__LLAVE=

# Cualquier ajuste de config/docubot.yaml se puede sobrescribir aquí con
# DOCUBOT_<SECCION>__<CAMPO>, por ejemplo:
# DOCUBOT_TRABAJADORES__DESCARGA=8

# Solo si la construcción de la imagen de la base se queda colgada descargando
# paquetes: algunas redes bloquean el user agent de apt.
# APT_USER_AGENT=Mozilla/5.0
